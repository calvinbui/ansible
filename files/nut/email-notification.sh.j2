#!/usr/bin/env bash

set -euo pipefail

NOTIFYTYPE=${NOTIFYTYPE:-TEST}
UPSNAME=${UPSNAME:-ups@localhost}
UPS_STATUS=$(upsc "$UPSNAME" 2>/dev/null) || UPS_STATUS="Unable to get UPS status"

if [[ "$NOTIFYTYPE" == "LOWBATT" ]]; then
  UPS_FLAGS=$(awk '$1 == "ups.status:" {$1=""; print; exit}' <<< "$UPS_STATUS")
  # Suppress only confirmed mains-power warnings; keep alerts if status is unknown.
  if [[ " $UPS_FLAGS " == *" OL "* && " $UPS_FLAGS " != *" OB "* ]]; then
    exit 0
  fi
fi

EMAIL_BODY="Subject: UPS Alert: $NOTIFYTYPE on $UPSNAME"
EMAIL_BODY+="\n\n"
EMAIL_BODY+="UPS: $UPSNAME\n"
EMAIL_BODY+="Alert type: $NOTIFYTYPE\n"
EMAIL_BODY+="Time: $(date)\n"
EMAIL_BODY+="UPS Status:\n"
EMAIL_BODY+="$UPS_STATUS"

printf "%b" "$EMAIL_BODY" | msmtp -a default {{ common_user }}{{ common_email_to }}
