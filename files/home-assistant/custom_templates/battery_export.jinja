{#
  Lowest SOC the AGL 17:00-21:00 export could finish at while still:
    - refilling to 100% by 17:00 tomorrow on a forecast halfway between Solcast P50 and P90
      (half-hourly; dampened by the integration's automated dampening). Falling short only moves
      export to the next evening at the same 28c, while filling early sends it out at 3c, so the
      forecast leans optimistic, and
    - keeping the early-morning low point 5 points above the inverter's SOC min.
  Steps from 21:00 today to 17:00 tomorrow in 30-minute steps with the same battery model as the
  solar dashboard forecast (53.6 kWh, 90.5% conversion, 9.65 kW charge, 10 kW discharge).
  House load is the 7-day hourly profile from sensor.house_load_profile. Night hours (21:00-07:00)
  are scaled to measured overnight battery drops from the last 7 nights: the refill check uses the
  average drop (an error there only moves export between nights), while the morning low-point check
  uses the largest drop so a heavy night never reaches SOC min. Both fall back to the heaviest
  night's load.
  Car: when the Zeekr is at least 10 points below its charge limit, the plan also charges it at
  2.3 kW between sunrise and sunset whenever solar covers the house plus the car (the same rule the
  Zeekr stop automation enforces), until it has the energy to reach its limit (100 kWh pack, 90%
  charger efficiency). This holds back export so the battery still fills by 17:00 with the car
  charging. Returns JSON.
#}
{% macro battery_export_plan() %}
  {%- set cap = 53.6 %}
  {%- set eff = 0.905 %}
  {%- set max_charge = 9.65 %}
  {%- set max_discharge = 10 %}
  {%- set floor = states('number.solplanet_battery_al010k5sq2590170_soc_min') | float(5) %}
  {%- set profile = state_attr('sensor.house_load_profile', 'profile') | from_json %}
  {%- set night_max = states('sensor.house_load_profile') | float(0) %}
  {%- set night_avg = state_attr('sensor.house_load_profile', 'night_avg_kwh') | float(0) %}
  {%- set fallback = (night_max / night_avg) if night_avg > 0 else 1 %}
  {%- set drop_max = state_attr('sensor.house_load_profile', 'night_drop_max_pct') | float(0) %}
  {%- set drop_avg = state_attr('sensor.house_load_profile', 'night_drop_avg_pct') | float(0) %}
  {%- set factor = (drop_max / 100 * cap * eff / night_avg) if drop_max > 0 and night_avg > 0 else fallback %}
  {%- set factor_typical = (drop_avg / 100 * cap * eff / night_avg) if drop_avg > 0 and night_avg > 0 else factor %}
  {%- set car_kw = 2.3 %}
  {%- set car_level = states('sensor.garage_zeekr_7x_awd_battery_level') | float(none) %}
  {%- set car_limit = states('number.garage_zeekr_7x_awd_charging_limit') | float(none) %}
  {%- set car_needed = ((car_limit - car_level) / 100 * 100 / 0.9)
                       if car_level is not none and car_limit is not none and car_limit - car_level >= 10
                       else 0 %}
  {%- set start = as_timestamp(today_at('21:00')) %}
  {%- set rise = as_timestamp(state_attr('sun.sun', 'next_rising'), 0) %}
  {%- set set_ = as_timestamp(state_attr('sun.sun', 'next_setting'), 0) %}
  {%- set rise = rise + 86400 if rise and rise < start else rise %}
  {%- set set_ = set_ + 86400 if set_ and set_ < rise else set_ %}
  {%- set ns = namespace(pv={}, c=0, low=0, low_at=none, car=0, c_typical=0) %}
  {%- for p in state_attr('sensor.solcast_pv_forecast_forecast_tomorrow', 'detailedForecast') or [] %}
    {%- set ns.pv = dict(ns.pv, **{(as_timestamp(p.period_start) | int | string): ((p.pv_estimate | float(0)) + (p.pv_estimate90 | float(0))) / 2}) %}
  {%- endfor %}
  {%- for i in range(40) %}
    {%- set t = today_at('21:00') + timedelta(minutes=30 * i) %}
    {%- set night = t.hour >= 21 or t.hour < 7 %}
    {%- set base = profile[t.hour] | float(1.2) %}
    {%- set load = base * (factor if night else 1) %}
    {%- set load_typical = base * (factor_typical if night else 1) %}
    {%- set pv = ns.pv.get(as_timestamp(t) | int | string, 0) %}
    {%- set car = car_kw if ns.car < car_needed and rise <= as_timestamp(t) < set_ and pv - load >= car_kw else 0 %}
    {%- set ns.car = ns.car + car * 0.5 %}
    {%- set net = pv - load - car %}
    {%- set kwh = ([net, max_charge] | min * eff if net >= 0 else [net, -max_discharge] | max / eff) * 0.5 %}
    {%- set ns.c = ns.c + kwh / cap * 100 %}
    {%- set net_typical = pv - load_typical - car %}
    {%- set kwh_typical = ([net_typical, max_charge] | min * eff if net_typical >= 0 else [net_typical, -max_discharge] | max / eff) * 0.5 %}
    {%- set ns.c_typical = ns.c_typical + kwh_typical / cap * 100 %}
    {%- if ns.c < ns.low %}
      {%- set ns.low = ns.c %}
      {%- set ns.low_at = (t + timedelta(minutes=30)).strftime('%H:%M') %}
    {%- endif %}
  {%- endfor %}
  {%- set refill = 100 - ns.c_typical %}
  {%- set overnight = floor + 5 - ns.low %}
  {%- set target = [[refill, overnight, floor] | max, 100] | min | round(0, 'ceil') %}
  {{- {
    'target': target,
    'refill_target': refill | round(1),
    'overnight_target': overnight | round(1),
    'low_point_soc': (target + ns.low) | round(1),
    'low_point_at': ns.low_at,
    'night_factor': factor | round(2),
    'night_factor_typical': factor_typical | round(2),
    'car_kwh': ns.car | round(1),
    'car_needed_kwh': car_needed | round(1)
  } | to_json -}}
{% endmacro %}
